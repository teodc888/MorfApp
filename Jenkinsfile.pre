// MorfApp Pre-Productivo Deployment Pipeline
// Triggered on push to any branch; builds and deploys to PRE environment

pipeline {
    agent any

    parameters {
        choice(
            name: 'DEPLOY_WHAT',
            choices: ['both', 'backend', 'frontend', 'superadmin', 'all'],
            description: 'What to deploy to PRE'
        )
    }

    environment {
        // Build configuration
        DOTNET_VERSION = '9.0'
        NODE_VERSION = '20'

        // PRE environment
        PRE_API_URL = 'https://api-pre.morfapp.app'
        PRE_WEB_URL = 'https://pre.morfapp.app'
        PRE_SUPERADMIN_URL = 'https://super-pre.morfapp.app'
        PRE_DB = 'morfapp_pre'
        PRE_DB_USER = 'morfapp'
        PRE_BACKEND_SERVICE = 'morfapp-pre-api'
        PRE_FRONTEND_SERVICE = 'morfapp-pre-web'
        PRE_SUPERADMIN_SERVICE = 'morfapp-pre-superadmin'

        // Server connection
        SERVER_USER = 'teo'
        SERVER_HOST = '100.95.233.68'
        SERVER_BACKEND_DIR = '/home/teo/morfapp-pre-api'
        SERVER_FRONTEND_DIR = '/home/teo/morfapp-pre-web'
        SERVER_SUPERADMIN_DIR = '/home/teo/morfapp-pre-superadmin'
        SERVER_SUDO_PASS = credentials('server-sudo-password')
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "✓ Repository checked out"
                    echo "Branch: ${GIT_BRANCH}"
                    echo "Commit: ${GIT_COMMIT}"
                }
            }
        }

        stage('Build Backend') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'backend' }
            }
            steps {
                dir('back') {
                    script {
                        echo "🔨 Building .NET backend for PRE..."
                        sh '''
                            dotnet publish -c Release -r linux-x64 --self-contained false \
                              -o publish-pre/
                            ls -lh publish-pre/
                        '''
                    }
                }
            }
        }

        stage('Deploy Backend to PRE') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'backend' }
            }
            steps {
                script {
                    echo "📤 Deploying backend to PRE..."
                    sh '''
                        # Upload backend artifacts
                        scp -r back/publish-pre/* ${SERVER_USER}@${SERVER_HOST}:${SERVER_BACKEND_DIR}/

                        # Restart service
                        ssh ${SERVER_USER}@${SERVER_HOST} << 'EOSSH'
                            echo $SERVER_SUDO_PASS | sudo -S systemctl restart ${PRE_BACKEND_SERVICE}
                            sleep 2
                            systemctl status ${PRE_BACKEND_SERVICE} --no-pager | head -5
EOSSH
                    '''
                }
            }
        }

        stage('Build Frontend') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'frontend' }
            }
            steps {
                dir('front') {
                    script {
                        echo "🔨 Building Next.js frontend for PRE..."
                        sh '''
                            npm install
                            NEXT_PUBLIC_API_URL=${PRE_API_URL} \
                            NEXT_PUBLIC_ROOT_DOMAIN=morfapp.app \
                            npm run build
                        '''
                    }
                }
            }
        }

        stage('Deploy Frontend to PRE') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'frontend' }
            }
            steps {
                script {
                    echo "📤 Deploying frontend to PRE..."
                    sh '''
                        cd front
                        tar --exclude='.next/dev' -czf /tmp/morfapp-pre-frontend.tar.gz .next public
                        scp /tmp/morfapp-pre-frontend.tar.gz ${SERVER_USER}@${SERVER_HOST}:/tmp/

                        # Extract and restart
                        ssh ${SERVER_USER}@${SERVER_HOST} << 'EOSSH'
                            cd ${SERVER_FRONTEND_DIR}
                            rm -rf .next public
                            tar -xzf /tmp/morfapp-pre-frontend.tar.gz
                            rm /tmp/morfapp-pre-frontend.tar.gz
                            echo $SERVER_SUDO_PASS | sudo -S systemctl restart ${PRE_FRONTEND_SERVICE}
                            sleep 2
                            systemctl status ${PRE_FRONTEND_SERVICE} --no-pager | head -5
EOSSH
                    '''
                }
            }
        }

        stage('Build SuperAdmin') {
            when {
                expression { params.DEPLOY_WHAT == 'superadmin' || params.DEPLOY_WHAT == 'all' }
            }
            steps {
                dir('superadmin') {
                    script {
                        echo "🔨 Building Next.js superadmin for PRE..."
                        sh '''
                            npm install
                            NEXT_PUBLIC_API_URL=${PRE_API_URL} \
                            npm run build
                        '''
                    }
                }
            }
        }

        stage('Deploy SuperAdmin to PRE') {
            when {
                expression { params.DEPLOY_WHAT == 'superadmin' || params.DEPLOY_WHAT == 'all' }
            }
            steps {
                script {
                    echo "📤 Deploying superadmin to PRE..."
                    sh '''
                        cd superadmin
                        tar --exclude='.next/dev' -czf /tmp/morfapp-pre-superadmin.tar.gz .next public
                        scp /tmp/morfapp-pre-superadmin.tar.gz ${SERVER_USER}@${SERVER_HOST}:/tmp/

                        # Extract and restart
                        ssh ${SERVER_USER}@${SERVER_HOST} << 'EOSSH'
                            cd ${SERVER_SUPERADMIN_DIR}
                            rm -rf .next public
                            tar -xzf /tmp/morfapp-pre-superadmin.tar.gz
                            rm /tmp/morfapp-pre-superadmin.tar.gz
                            echo $SERVER_SUDO_PASS | sudo -S systemctl restart ${PRE_SUPERADMIN_SERVICE}
                            sleep 2
                            systemctl status ${PRE_SUPERADMIN_SERVICE} --no-pager | head -5
EOSSH
                    '''
                }
            }
        }

        stage('Health Check PRE') {
            steps {
                script {
                    echo "🏥 Checking PRE health..."
                    sh '''
                        sleep 3

                        API_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://api-pre.morfapp.app/health || echo "000")
                        WEB_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://pre.morfapp.app || echo "000")
                        SUPERADMIN_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://super-pre.morfapp.app || echo "000")

                        echo "PRE API:       $API_STATUS"
                        echo "PRE Frontend:  $WEB_STATUS"
                        echo "PRE SuperAdmin: $SUPERADMIN_STATUS"

                        if [ "$API_STATUS" != "200" ] || [ "$WEB_STATUS" != "200" ]; then
                            echo "⚠️  Warning: not all core services returned 200"
                        else
                            echo "✓ All PRE core services healthy"
                        fi

                        if [ "$SUPERADMIN_STATUS" != "200" ] && [ "${DEPLOY_WHAT}" = "superadmin" ] || [ "${DEPLOY_WHAT}" = "all" ]; then
                            echo "⚠️  Warning: SuperAdmin health check returned $SUPERADMIN_STATUS"
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Pipeline completed for: ${params.DEPLOY_WHAT}"
            }
        }
        success {
            echo "✅ PRE deployment successful!"
        }
        failure {
            echo "❌ Deployment failed!"
        }
    }
}
