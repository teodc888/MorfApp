// MorfApp Production Deployment Pipeline
// MANUAL TRIGGER ONLY — requires explicit approval to deploy to production

pipeline {
    agent any

    parameters {
        choice(
            name: 'DEPLOY_WHAT',
            choices: ['both', 'backend', 'frontend'],
            description: 'What to deploy to PRODUCTION'
        )
        booleanParam(
            name: 'CONFIRM_PRODUCTION',
            defaultValue: false,
            description: 'I understand this will deploy to PRODUCTION'
        )
    }

    environment {
        // Build configuration
        DOTNET_VERSION = '9.0'
        NODE_VERSION = '20'

        // PRODUCTION environment
        PROD_API_URL = 'https://api.morfapp.app'
        PROD_WEB_URL = 'https://morfapp.app'
        PROD_DB = 'morfapp'
        PROD_DB_USER = 'morfapp'
        PROD_BACKEND_SERVICE = 'morfapp-api'
        PROD_FRONTEND_SERVICE = 'morfapp-web'

        // Server connection
        SERVER_USER = 'teo'
        SERVER_HOST = '100.95.233.68'
        SERVER_BACKEND_DIR = '/home/teo/morfapp-api'
        SERVER_FRONTEND_DIR = '/home/teo/morfapp-web'
        SERVER_SUDO_PASS = credentials('server-sudo-password')
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    stages {
        stage('Confirm Production Deployment') {
            steps {
                script {
                    if (!params.CONFIRM_PRODUCTION) {
                        error '❌ PRODUCTION deployment requires explicit confirmation. Re-run with CONFIRM_PRODUCTION=true'
                    }
                    echo "⚠️  DEPLOYING TO PRODUCTION"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "✓ Repository checked out"
                    echo "Branch: ${GIT_BRANCH}"
                    echo "Commit: ${GIT_COMMIT}"
                }
            }
        }

        stage('Build Backend') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'backend' }
            }
            steps {
                dir('back') {
                    script {
                        echo "🔨 Building .NET backend for PRODUCTION..."
                        sh '''
                            dotnet publish -c Release -r linux-x64 --self-contained false \
                              -o publish-prod/
                            ls -lh publish-prod/
                        '''
                    }
                }
            }
        }

        stage('Deploy Backend to PRODUCTION') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'backend' }
            }
            steps {
                script {
                    echo "📤 Deploying backend to PRODUCTION..."
                    sh '''
                        # Upload backend artifacts
                        scp -r back/publish-prod/* ${SERVER_USER}@${SERVER_HOST}:${SERVER_BACKEND_DIR}/

                        # Restart service
                        ssh ${SERVER_USER}@${SERVER_HOST} << 'EOSSH'
                            echo $SERVER_SUDO_PASS | sudo -S systemctl restart ${PROD_BACKEND_SERVICE}
                            sleep 2
                            systemctl status ${PROD_BACKEND_SERVICE} --no-pager | head -5
EOSSH
                    '''
                }
            }
        }

        stage('Build Frontend') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'frontend' }
            }
            steps {
                dir('front') {
                    script {
                        echo "🔨 Building Next.js frontend for PRODUCTION..."
                        sh '''
                            npm install
                            NEXT_PUBLIC_API_URL=${PROD_API_URL} \
                            NEXT_PUBLIC_ROOT_DOMAIN=morfapp.app \
                            npm run build
                        '''
                    }
                }
            }
        }

        stage('Deploy Frontend to PRODUCTION') {
            when {
                expression { params.DEPLOY_WHAT == 'both' || params.DEPLOY_WHAT == 'frontend' }
            }
            steps {
                script {
                    echo "📤 Deploying frontend to PRODUCTION..."
                    sh '''
                        cd front
                        tar --exclude='.next/dev' -czf /tmp/morfapp-prod-frontend.tar.gz .next public
                        scp /tmp/morfapp-prod-frontend.tar.gz ${SERVER_USER}@${SERVER_HOST}:/tmp/

                        # Extract and restart
                        ssh ${SERVER_USER}@${SERVER_HOST} << 'EOSSH'
                            cd ${SERVER_FRONTEND_DIR}
                            rm -rf .next public
                            tar -xzf /tmp/morfapp-prod-frontend.tar.gz
                            rm /tmp/morfapp-prod-frontend.tar.gz
                            echo $SERVER_SUDO_PASS | sudo -S systemctl restart ${PROD_FRONTEND_SERVICE}
                            sleep 2
                            systemctl status ${PROD_FRONTEND_SERVICE} --no-pager | head -5
EOSSH
                    '''
                }
            }
        }

        stage('Health Check PRODUCTION') {
            steps {
                script {
                    echo "🏥 Checking PRODUCTION health..."
                    sh '''
                        sleep 3

                        API_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://api.morfapp.app/health || echo "000")
                        WEB_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://morfapp.app || echo "000")

                        echo "PROD API:      $API_STATUS"
                        echo "PROD Frontend: $WEB_STATUS"

                        if [ "$API_STATUS" != "200" ] || [ "$WEB_STATUS" != "200" ]; then
                            error "❌ PRODUCTION health check failed!"
                        else
                            echo "✓ All PRODUCTION services healthy"
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Production deployment pipeline completed for: ${params.DEPLOY_WHAT}"
            }
        }
        success {
            echo "✅ PRODUCTION deployment successful!"
        }
        failure {
            echo "❌ Production deployment failed!"
        }
    }
}
